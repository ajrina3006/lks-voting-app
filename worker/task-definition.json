{
  "family": "lks-td-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::682791326537:role/LabRole",
  "taskRoleArn": "arn:aws:iam::682791326537:role/LabRole",
  "containerDefinitions": [
    {
      "name": "lks-worker-container",
      "image": "682791326537.dkr.ecr.us-east-1.amazonaws.com/lks-voting-image",
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/lks-td-worker",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}

